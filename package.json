{
  "name": "staff-pulse-dashboard",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "node --env-file-if-exists=.env scripts/dev.mjs",
    "server": "node --env-file-if-exists=.env server/index.mjs",
    "test": "vitest run src && node --test server/*.test.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "build": "vite build"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.102.8",
    "@vitejs/plugin-react": "latest",
    "react": "latest",
    "react-dom": "latest",
    "styled-components": "latest",
    "typescript": "5.9.3",
    "vite": "latest",
    "zod": "latest"
  },
  "devDependencies": {
    "@eslint/js": "latest",
    "@types/node": "latest",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "@typescript-eslint/eslint-plugin": "latest",
    "@typescript-eslint/parser": "latest",
    "eslint": "latest",
    "eslint-plugin-react-hooks": "latest",
    "eslint-plugin-react-refresh": "latest",
    "globals": "latest",
    "vitest": "^3.2.7"
  }
}
