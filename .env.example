API_PORT=3001

#   normal  — return the valid organization fixture immediately.
#   delay   — return the fixture after ORG_TREE_DELAY_MS milliseconds.
#   empty   — return an empty organization array.
#   error   — return HTTP 503.
#   invalid — return HTTP 200 with an invalid payload.
# Default: normal.
ORG_TREE_MODE=normal

# Response delay used only when ORG_TREE_MODE=delay.
ORG_TREE_DELAY_MS=0

# Realtime SSE patch generator mode.
#   generated — deterministic updates distributed across the fixture.
#   scripted  — use the SCRIPTED_PATCHES aggregate-demo cycle.
REALTIME_MODE=generated

# Delay between generated SSE metric patches.
REALTIME_INTERVAL_MS=5000
